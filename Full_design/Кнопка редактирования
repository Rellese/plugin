/* Кнопка редактировать */

box-sizing: border-box;

position: relative;
width: 60px;
height: 120px;

border: 1px dashed #9747FF;
border-radius: 5px;


/* Status=Pressed */

/* Auto layout */
display: flex;
flex-direction: row;
justify-content: center;
align-items: center;
padding: 10px;
gap: 10px;

position: absolute;
width: 20px;
height: 20px;
left: 20px;
top: 80px;

background: linear-gradient(0deg, rgba(180, 180, 180, 0.15), rgba(180, 180, 180, 0.15)), linear-gradient(180deg, rgba(25, 25, 25, 0.2) 0%, rgba(22, 22, 22, 0.2) 100%);
box-shadow: 0px 0px 0px 2px rgba(180, 180, 180, 0.1), inset 0px 0px 0px 1px rgba(180, 180, 180, 0.1);
border-radius: 5px;


/* Union */

width: 7.23px;
height: 15.03px;

background: rgba(180, 180, 180, 0.5);
transform: rotate(45deg);

/* Inside auto layout */
flex: none;
order: 0;
flex-grow: 0;


/* Rectangle 626 (Stroke) */

