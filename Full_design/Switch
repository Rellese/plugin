/* State=On, Status=Enable2 */

position: absolute;
width: 36px;
height: 18px;
left: 20px;
top: 140px;



/* outer shell */

position: absolute;
left: 0%;
right: 0%;
top: 0%;
bottom: 0%;

background: rgba(211, 82, 45, 0.2);
box-shadow: inset 0.6px 0.8px 1.2px #922D10, inset -0.4px -0.6px 1px rgba(248, 121, 85, 0.8);
