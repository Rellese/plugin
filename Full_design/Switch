/* inner shadow */

box-sizing: border-box;

position: absolute;
left: 11.11%;
right: 11.11%;
top: 22.22%;
bottom: 22.22%;

background: #070709;
border-radius: 5.4px;


/* inner lining */

position: absolute;
left: 13.89%;
right: 13.89%;
top: 27.78%;
bottom: 27.78%;

background: radial-gradient(98.16% 65.91% at 50% 0%, rgba(246, 213, 203, 0.839216) 0%, rgba(211, 82, 45, 0.2) 64.39%, rgba(211, 82, 45, 0) 100%), radial-gradient(60.89% 100% at 50% 0%, #D3522D 16.64%, #AB3919 90.26%, #69200C 100%);
box-shadow: inset 0px -0.8px 0.8px #06050A;
border-radius: 5.4px;


/* container */

/* Auto layout */
display: flex;
flex-direction: row;
align-items: center;
padding: 1px;
gap: 1px;

position: absolute;
left: 30.56%;
right: 5.56%;
top: 11.11%;
